      "mcp__Logfire",
      "mcp__Neon__list_projects",
      "mcp__Neon__list_organizations",
      "mcp__Neon__list_shared_projects",
      "mcp__Neon__describe_project",
      "mcp__Neon__describe_branch",
      "mcp__Neon__describe_table_schema",
      "mcp__Neon__compare_database_schema",
      "mcp__Neon__get_database_tables",
      "mcp__Neon__inspect_database",
      "mcp__Neon__list_branch_computes",
      "mcp__Neon__list_slow_queries",
      "mcp__Neon__list_log_fields",
      "mcp__Neon__list_log_field_values",
      "mcp__Neon__query_logs",
      "mcp__Neon__explain_sql_statement",
      "mcp__Neon__search",
      "mcp__Neon__list_docs_resources",
      "mcp__Neon__get_doc_resource",
      "mcp__Slack__slack_read_channel",
      "mcp__Slack__slack_read_thread",
      "mcp__Slack__slack_read_canvas",
      "mcp__Slack__slack_read_file",
      "mcp__Slack__slack_read_user_profile",
      "mcp__Slack__slack_list_channel_members",
      "mcp__Slack__slack_get_reactions",
      "mcp__Slack__slack_search_channels",
      "mcp__Slack__slack_search_users",
      "mcp__Slack__slack_search_emojis",
      "mcp__Slack__slack_search_public",
      "mcp__Slack__slack_search_public_and_private",
      "mcp__Slack__slack_send_message_draft",
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__list_recent_files",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__download_file_content",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__get_file_permissions",
      "Bash(./scripts/worktree-create.sh:*)",
      "Bash(./scripts/worktree-provision.sh:*)",
      "Bash(./scripts/worktree-cleanup.sh:*)",
      "Bash(./scripts/worktree-remove.sh:*)",
      "Bash(./scripts/worktree-test.sh:*)",
      "Bash(python3 scripts/worktree.py:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(.env)"
    ],
    "ask": [
      "mcp__Railway__create-deployment",
      "mcp__Railway__redeploy",
      "mcp__Railway__accept-deploy",
      "mcp__Railway__deploy-template",
      "mcp__Railway__create-project",
      "mcp__Railway__create-service",
      "mcp__Railway__generate-domain",
      "mcp__Railway__set-variables",
      "mcp__Railway__delete-service",
      "mcp__Railway__delete-volume",
      "mcp__Railway__delete-bucket",
      "mcp__Railway__delete-tcp-proxy",
      "mcp__Railway__delete-domain"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "shadcn",
    "playwright"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/setup_remote.sh",
            "timeout": 60000
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-provision.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(accept-deploy|connect-service-source|create-bucket|create-deployment|create-function|create-project|create-service|create-tcp-proxy|create-volume|create-webhook|delete-bucket|delete-domain|delete-feature-flag|delete-service|delete-tcp-proxy|delete-volume|delete-webhook|deploy-template|generate-domain|purge-cdn-cache|railway-agent|redeploy|reset-bucket-credentials|restart-service|retry-domain-certificate|set-beta-feature|set-feature-flag|set-service-tracing|set-variables|update-bucket|update-domain|update-function-source-code|update-service|update-volume|update-webhook)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/railway-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(delete_branch|delete_project|run_sql|run_sql_transaction|complete_database_migration|complete_query_tuning)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/neon-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-format.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message 'Claude needs your input' -title 'Claude Code' -sound Glass -group 'claude-code'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "astral@astral-sh": true,
    "frontend-design@claude-plugins-official": true
  }
}
