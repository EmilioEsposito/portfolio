      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Bash(git remote:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
