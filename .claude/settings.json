      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(gh:*)",
      "Bash(./scripts:*)",
      "Bash(ngrok:*)",
      "mcp__playwright",
      "mcp__context7",
      "mcp__chrome-devtools",
      "mcp__shadcn",
      "mcp__Railway__whoami",
      "mcp__Railway__list-workspaces",
      "mcp__Railway__list-projects",
      "mcp__Railway__list-services",
      "mcp__Railway__list-deployments",
      "mcp__Railway__list-variables",
      "mcp__Railway__list-domains",
      "mcp__Railway__list-tcp-proxies",
      "mcp__Railway__get-logs",
      "mcp__Railway__get-service-config",
      "mcp__Railway__get-service-metrics",
      "mcp__Railway__http-requests",
      "mcp__Railway__http-error-rate",
      "mcp__Railway__http-response-time",
      "mcp__Railway__environment-status",
      "mcp__Railway__domain-status",
      "mcp__Railway__search-docs",
      "mcp__Railway__fetch-docs",
      "mcp__Railway__search-templates",
      "mcp__cloudflare-api__docs",
      "mcp__cloudflare-api__search",
