{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(uv:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(pkill:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Bash(git remote:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(chmod:*)",
      "Bash(source:*)",
      "Bash(pwd)",
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(gh:*)",
      "Bash(./scripts:*)",
      "Bash(ngrok:*)",
      "mcp__playwright",
      "mcp__context7",
      "mcp__chrome-devtools",
      "mcp__shadcn",
      "mcp__github",
      "mcp__Railway__whoami",
      "mcp__Railway__list_workspaces",
      "mcp__Railway__list_projects",
      "mcp__Railway__list_services",
      "mcp__Railway__list_deployments",
      "mcp__Railway__list_variables",
      "mcp__Railway__list_domains",
      "mcp__Railway__list_tcp_proxies",
      "mcp__Railway__get_logs",
      "mcp__Railway__get_service_config",
      "mcp__Railway__get_tcp_proxy",
      "mcp__Railway__service_metrics",
      "mcp__Railway__http_requests",
      "mcp__Railway__http_error_rate",
      "mcp__Railway__http_response_time",
      "mcp__Railway__environment_status",
      "mcp__Railway__domain_status",
      "mcp__Railway__private_network_status",
      "mcp__Railway__docs_search",
      "mcp__Railway__docs_fetch",
      "mcp__Railway__search_templates",
      "mcp__Railway__link_environment",
      "mcp__cloudflare-dns",
      "mcp__cloudflare-docs",
      "mcp__cloudflare-api__docs",
      "mcp__cloudflare-api__search",
      "mcp__claude-in-chrome",
      "mcp__logfire",
      "mcp__Logfire",
      "mcp__Neon__list_projects",
      "mcp__Neon__list_organizations",
      "mcp__Neon__list_shared_projects",
      "mcp__Neon__describe_project",
      "mcp__Neon__describe_branch",
      "mcp__Neon__describe_table_schema",
      "mcp__Neon__compare_database_schema",
      "mcp__Neon__get_database_tables",
      "mcp__Neon__inspect_database",
      "mcp__Neon__list_branch_computes",
      "mcp__Neon__list_slow_queries",
      "mcp__Neon__list_log_fields",
      "mcp__Neon__list_log_field_values",
      "mcp__Neon__query_logs",
      "mcp__Neon__explain_sql_statement",
      "mcp__Neon__search",
      "mcp__Neon__list_docs_resources",
      "mcp__Neon__get_doc_resource",
      "mcp__Slack__slack_read_channel",
      "mcp__Slack__slack_read_thread",
      "mcp__Slack__slack_read_canvas",
      "mcp__Slack__slack_read_file",
      "mcp__Slack__slack_read_user_profile",
      "mcp__Slack__slack_list_channel_members",
      "mcp__Slack__slack_get_reactions",
      "mcp__Slack__slack_search_channels",
      "mcp__Slack__slack_search_users",
      "mcp__Slack__slack_search_emojis",
      "mcp__Slack__slack_search_public",
      "mcp__Slack__slack_search_public_and_private",
      "mcp__Slack__slack_send_message_draft",
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__list_recent_files",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__download_file_content",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__get_file_permissions"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(.env)"
    ],
    "ask": [
      "mcp__Railway__deploy",
      "mcp__Railway__deploy_template",
      "mcp__Railway__create_project",
      "mcp__Railway__create_environment",
      "mcp__Railway__create_service",
      "mcp__Railway__generate_domain",
      "mcp__Railway__set_variables",
      "mcp__Railway__link_service",
      "mcp__Railway__scale_service",
      "mcp__Railway__remove_service",
      "mcp__Railway__remove_volume",
      "mcp__Railway__remove_bucket",
      "mcp__Railway__remove_tcp_proxy",
      "mcp__Railway__delete_domain"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "shadcn",
    "playwright"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/setup_remote.sh",
            "timeout": 60000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__Railway__link-environment",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/railway-link-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__Railway__link_environment",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/railway-link-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__Neon__delete_branch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/neon-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__Neon__delete_project",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/neon-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__Neon__run_sql",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/neon-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__Neon__run_sql_transaction",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/neon-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__Neon__complete_database_migration",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/neon-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__Neon__complete_query_tuning",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/neon-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-format.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message 'Claude needs your input' -title 'Claude Code' -sound Glass -group 'claude-code'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "astral@astral-sh": true,
    "frontend-design@claude-plugins-official": true
  }
}
